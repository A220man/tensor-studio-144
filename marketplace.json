        "rust-analyzer": {
          "command": "rust-analyzer",
          "args": [],
          "extensionToLanguage": {
            ".rs": "rust"
          },
          "transport": "stdio",
          "initializationOptions": {}
        }
      },
      "strict": false
    }
    ,
    {
      "name": "clangd-lsp",
      "displayName": "Clangd LSP",
      "description": "C/C++ language server support via clangd",
      "source": "plugins/clangd-lsp",
      "lspServers": {
        "clangd": {
          "command": "clangd",
          "args": [],
          "extensionToLanguage": {
            ".c": "cpp",
            ".cc": "cpp",
            ".cpp": "cpp",
            ".cxx": "cpp",
            ".h": "cpp",
            ".hpp": "cpp"
          },
          "transport": "stdio",
          "initializationOptions": {}
