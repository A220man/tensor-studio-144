{
  "schemaVersion": 1,
  "name": "claude-plugins-official",
  "displayName": "Claude Plugins Official",
  "description": "Official, Anthropic-managed directory of high quality Claude Code Plugins.",
  "plugins": [
    {
      "name": "typescript-lsp",
      "displayName": "TypeScript LSP",
      "description": "TypeScript/JavaScript language server support via typescript-language-server",
      "source": "plugins/typescript-lsp",
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescript",
            ".js": "javascript",
            ".jsx": "javascript",
            ".mjs": "javascript",
            ".cjs": "javascript"
          },
          "transport": "stdio",
          "initializationOptions": {
            "hostInfo": "claude-plugins-official"
          }
        }
      },
      "strict": false
    }
    ,
    {
      "name": "vue-volar-lsp",
      "displayName": "Vue/Volar LSP",
      "description": "Vue.js language server support via Volar (@vue/language-server)",
      "source": "plugins/vue-volar-lsp",
      "lspServers": {
        "vue": {
          "command": "vue-language-server",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".vue": "vue"
          },
          "transport": "stdio",
          "initializationOptions": {
            "typescript": {
              "tsdk": "node_modules/typescript/lib"
            }
          }
        }
      },
      "strict": false
    }
    ,
    {
      "name": "pyright-lsp",
      "displayName": "Pyright LSP",
      "description": "Python language server support via pyright",
      "source": "plugins/pyright-lsp",
      "lspServers": {
        "pyright": {
          "command": "pyright-langserver",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".py": "python"
          },
          "transport": "stdio",
          "initializationOptions": {}
        }
      },
      "strict": false
    }
    ,
    {
      "name": "gopls-lsp",
      "displayName": "gopls LSP",
      "description": "Go language server support via gopls",
      "source": "plugins/gopls-lsp",
      "lspServers": {
        "gopls": {
          "command": "gopls",
          "args": ["serve"],
          "extensionToLanguage": {
            ".go": "go"
          },
          "transport": "stdio",
          "initializationOptions": {}
        }
      },
      "strict": false
    }
    ,
    {
      "name": "rust-analyzer-lsp",
      "displayName": "Rust Analyzer LSP",
      "description": "Rust language server support via rust-analyzer",
      "source": "plugins/rust-analyzer-lsp",
